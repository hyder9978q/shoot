rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // حسابات المسؤولين (admin UIDs) — نفس القائمة المكتوبة بملف
    // lib/core/constants/admin_config.dart بالتطبيق. تتحكم بمين يشوف
    // ويدير لوحة اقتراحات الملاعب. لإضافة حساب جديد: ضيف الـ UID هنا
    // وبنفس الوقت بملف admin_config.dart، وانشر القواعد من جديد.
    function isAdmin() {
      return request.auth != null && request.auth.uid in [
        'zbILiMg4wVVmVdKjM6Z4YXwTuW52' // +9647701234567
      ];
    }

    // الملاعب: أي شخص يكدر يقراها، والإضافة/الحذف فقط من لوحة التحكم.
    // صاحب الملعب يگدر يعدّل ملعبه هو فقط، وبس الحقول المسموحة أدناه —
    // ownerId والتقييم وبقية الحقول محمية (مو ضمن القائمة = التعديل مرفوض).
    match /fields/{fieldId} {
      // القيم ضمن حدود منطقية — نفحص فقط الحقول اللي انتعدّلت بهذي الكتابة
      // (المستندات القديمة ما بيها الحقول الجديدة، فما نفحص غير المتغيّر)
      function validOwnerValues() {
        let d = request.resource.data;
        let keys = request.resource.data.diff(resource.data).affectedKeys();
        return (!keys.hasAny(['name'])
                || (d.name is string && d.name.size() > 0
                    && d.name.size() <= 50))
          && (!keys.hasAny(['area'])
                || (d.area is string && d.area.size() > 0
                    && d.area.size() <= 50))
          && (!keys.hasAny(['city'])
                || (d.city is string && d.city.size() > 0
                    && d.city.size() <= 30))
          && (!keys.hasAny(['sport'])
                || d.sport in ['football', 'padel', 'basketball', 'tennis',
                               'volleyball', 'swimming', 'gym',
                               'sportsCentre', 'therapy'])
          && (!keys.hasAny(['pricePerHour'])
                || (d.pricePerHour is int && d.pricePerHour >= 0
                    && d.pricePerHour <= 1000000))
          && (!keys.hasAny(['openHour', 'closeHour'])
                || (d.openHour is int && d.openHour >= 0 && d.openHour <= 23
                    && d.closeHour is int && d.closeHour >= 1
                    && d.closeHour <= 24 && d.openHour < d.closeHour))
          && (!keys.hasAny(['isOpen']) || d.isOpen is bool)
          && (!keys.hasAny(['mapsUrl'])
                || (d.mapsUrl is string && d.mapsUrl.size() <= 500
                    && (d.mapsUrl == ''
                        || d.mapsUrl.matches('https://.*'))))
          // رقم تواصل المنشأة العام — فاضي (بعده ما تحدد) أو رقم عراقي
          // دولي صحيح (+964 وبعده ٩ أرقام تبدي بـ٧) — منفصل عن رقم
          // حساب صاحب المنشأة الشخصي، وهذا وحده يظهر للاعبين
          && (!keys.hasAny(['contactPhone'])
                || (d.contactPhone is string
                    && (d.contactPhone == ''
                        || d.contactPhone.matches('\\+9647[0-9]{9}'))))
          // قوائم الصور/الهايلايتس: نوع وحد أقصى للطول — تفاصيل كل عنصر
          // (رابط https صالح) يتحقق منها التطبيق قبل الرفع؛ قواعد
          // Firestore ما تگدر تتحقق من كل عنصر بقائمة بدون تكرار (loop)
          && (!keys.hasAny(['imageUrls'])
                || (d.imageUrls is list && d.imageUrls.size() <= 20))
          && (!keys.hasAny(['promoImageUrls'])
                || (d.promoImageUrls is list && d.promoImageUrls.size() <= 20))
          && (!keys.hasAny(['highlights'])
                || (d.highlights is list && d.highlights.size() <= 20))
          && (!keys.hasAny(['paymentDeposit', 'paymentCashOnArrival',
                            'zainCashEnabled', 'zainCashMerchantId'])
                || (d.paymentDeposit is bool
                    && d.paymentCashOnArrival is bool
                    && (d.paymentDeposit || d.paymentCashOnArrival)
                    && d.zainCashEnabled is bool
                    && d.zainCashMerchantId is string
                    && d.zainCashMerchantId.size() <= 50))
          && (!keys.hasAny(['services'])
                || (d.services is list && d.services.size() <= 20));
      }

      // منشأة جديدة يسجّلها صاحبها بنفسه من التطبيق (تبويب "منشآتي") —
      // لازم يملكها هو (ownerId يطابق حسابه)، وتبدي نشيطة وبدون تقييم
      // مزوّر ولا وسائط ملفّقة (كلها فاضية عند الإنشاء).
      function validNewField() {
        let d = request.resource.data;
        return d.ownerId == request.auth.uid
          && d.name is string && d.name.size() > 0 && d.name.size() <= 50
          && d.area is string && d.area.size() > 0 && d.area.size() <= 50
          && d.city is string && d.city.size() > 0 && d.city.size() <= 30
          && d.sport in ['football', 'padel', 'basketball', 'tennis',
                         'volleyball', 'swimming', 'gym',
                         'sportsCentre', 'therapy']
          && d.pricePerHour is int && d.pricePerHour > 0
          && d.pricePerHour <= 1000000
          && d.openHour is int && d.openHour >= 0 && d.openHour <= 23
          && d.closeHour is int && d.closeHour >= 1 && d.closeHour <= 24
          && d.openHour < d.closeHour
          && d.isOpen == true
          // بانتظار المراجعة: المنشأة الجديدة تنولد معطّلة، فما تظهر
          // بالبحث ولا بالخريطة ولا تنحجز. المسؤول وحده يفعّلها من
          // لوحته — هذا يمنع أي حد يزرع منشآت وهمية تبين للاعبين فوراً.
          && d.isActive == false
          && d.rating == 0 && d.reviewsCount == 0
          && d.imageUrls == [] && d.promoImageUrls == []
          && d.highlights == [] && d.services == []
          && d.paymentDeposit is bool && d.paymentCashOnArrival is bool
          && (d.paymentDeposit || d.paymentCashOnArrival)
          && d.zainCashEnabled is bool
          && d.zainCashMerchantId is string
          && d.zainCashMerchantId.size() <= 50
          // رقم تواصل المنشأة مطلوب من الإنشاء — منشأة جديدة لازم يكون
          // عندها رقم يتواصل عليه الزبائن من أول يوم
          && d.contactPhone is string
          && d.contactPhone.matches('\\+9647[0-9]{9}');
      }

      allow read: if true;
      allow create: if request.auth != null && validNewField();
      allow delete: if false;
      // المسؤول يفعّل/يعطّل المنشأة بعد المراجعة — هذا الحقل الوحيد
      // اللي يلمسه، وصاحب المنشأة ما يگدر يفعّل نفسه (isActive مو ضمن
      // قائمة حقوله أدناه)
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['isActive'])
        && request.resource.data.isActive is bool;
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'imageUrls', 'promoImageUrls', 'highlights', 'mapsUrl',
             'name', 'area', 'city', 'sport', 'pricePerHour',
             'openHour', 'closeHour', 'isOpen', 'contactPhone',
             'paymentDeposit', 'paymentCashOnArrival',
             'zainCashEnabled', 'zainCashMerchantId', 'services'
           ])
        && validOwnerValues();
    }

    // إعلانات صاحب المنشأة (عروض/بطولات/أخبار/أوقات متاحة): أي شخص
    // يقراها (التطبيق يفلتر النشيطة وغير المنتهية عند العرض)، وصاحب
    // المنشأة فقط ينشر/يعدّل/يحذف إعلانات منشأته هو — فحص ملكية صارم
    // بنفس نمط مجموعة fields.
    match /ads/{adId} {
      function isFieldOwnerOf(fieldId) {
        return request.auth != null
          && exists(/databases/$(database)/documents/fields/$(fieldId))
          && get(/databases/$(database)/documents/fields/$(fieldId))
               .data.ownerId == request.auth.uid;
      }

      function validAd() {
        let d = request.resource.data;
        return d.title is string && d.title.size() > 0 && d.title.size() <= 60
          && d.body is string && d.body.size() > 0 && d.body.size() <= 300
          && d.type in ['promo', 'tournament', 'news', 'availability']
          && d.expiresAt is string
          && d.expiresAt.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && d.imageUrl is string && d.imageUrl.size() <= 500
              && (d.imageUrl == '' || d.imageUrl.matches('https://.*'))
          && d.isActive is bool
          && d.createdAtMs is int
          && d.fieldName is string && d.fieldName.size() <= 50;
      }

      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && isFieldOwnerOf(request.resource.data.fieldId)
        && validAd();
      // fieldId/ownerId/fieldName ثابتة للأبد — التعديل بس على محتوى
      // الإعلان نفسه، وما يگدر ينقله لمنشأة ثانية أو ينتحل ملكية غيره
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.fieldId == resource.data.fieldId
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['title', 'body', 'type', 'expiresAt', 'imageUrl',
                       'isActive'])
        && validAd();
      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    // الحجوزات:
    // - القراءة لأي مستخدم مسجّل (حتى يشوف الأوقات المحجوزة بالملعب)
    // - الإنشاء باسمه فقط، ومعرّف المستند fieldId_date_hour يمنع
    //   الحجز المزدوج: الكتابة فوق حجز شخص ثاني = update مرفوض
    // - أو حجز يدوي من صاحب الملعب (userId فارغ) — نفس معرّف المستند
    //   فنفس منع الحجز المزدوج يشتغل بالاتجاهين (يمنع لاعب يحجز وقت
    //   محجوز يدوياً، ويمنع المالك يسجّل حجز يدوي فوق حجز لاعب حقيقي)
    // - التعديل والحذف لصاحب الحجز فقط
    // - الحذف كذلك لصاحب الملعب (إلغاء اضطراري أو حذف حجز يدوي) — وهذا
    //   يوجب عليه سجل إلغاء بمجموعة cancellations للحجوزات الحقيقية بس
    //   (التطبيق ما يسجّل إلغاء لحجز يدوي — مو تقصير بحق لاعب حقيقي)
    match /bookings/{bookingId} {
      function isFieldOwner(fieldId) {
        return request.auth != null
          && exists(/databases/$(database)/documents/fields/$(fieldId))
          && get(/databases/$(database)/documents/fields/$(fieldId))
               .data.ownerId == request.auth.uid;
      }

      // معرّف المستند لازم يطابق fieldId_date_hour فعلاً — بدون هذا الفحص
      // يگدر عميل مفبرك يختار معرّف عشوائي فيلتف حول منع الحجز المزدوج
      function validBookingId() {
        let d = request.resource.data;
        return d.fieldId is string && d.date is string && d.hour is int
          && bookingId == d.fieldId + '_' + d.date + '_' + string(d.hour);
      }

      // قيم الحجز الأساسية منطقية: تاريخ بصيغة yyyy-MM-dd وساعة ضمن
      // اليوم. بدونها يگدر عميل مفبرك يزرع مستندات بتواريخ وساعات
      // خرافية تخرّب شبكة الأوقات والإحصائيات
      function validSlotValues() {
        let d = request.resource.data;
        return d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && d.hour >= 0 && d.hour <= 23;
      }

      // المنشأة موجودة ومفعّلة — ما ينحجز عليها قبل مراجعة المسؤول
      function fieldIsActive(fieldId) {
        return exists(/databases/$(database)/documents/fields/$(fieldId))
          && get(/databases/$(database)/documents/fields/$(fieldId))
               .data.get('isActive', false) == true;
      }

      // ضمان صالح: سجل إلغاء حقيقي بحق نفس اللاعب وما انستهلك بعد.
      // بدونه ينعفي أي واحد نفسه من العربون بمجرد ما يحط
      // depositWaived = true من عميل مفبرك
      function validGuarantee() {
        let id = request.resource.data.replacesCancellationId;
        return id is string && id != ''
          && exists(/databases/$(database)/documents/cancellations/$(id))
          && get(/databases/$(database)/documents/cancellations/$(id))
               .data.playerId == request.auth.uid
          && get(/databases/$(database)/documents/cancellations/$(id))
               .data.compensated == false;
      }

      // العربون: ٥٠٠٠ دينار ثابتة، ولا إعفاء إلا بضمان صالح (وقتها صفر)
      function validDeposit() {
        let d = request.resource.data;
        return d.depositWaived is bool
          && (d.depositWaived
                ? (d.deposit == 0 && validGuarantee())
                : d.deposit == 5000);
      }

      // حجز عادي من لاعب حقيقي لنفسه. رقم الهاتف ما ينخزن هنا أبداً —
      // محله المستند الفرعي private/contact أدناه
      function validPlayerBooking() {
        let d = request.resource.data;
        return d.isManual != true
          && d.userId == request.auth.uid
          && !('userPhone' in d) && !('customerName' in d) && !('note' in d)
          && validSlotValues()
          && validDeposit()
          && fieldIsActive(d.fieldId);
      }

      // حجز يدوي من صاحب الملعب لزبون خارج التطبيق — userId فارغ عمداً
      // (ما يرتبط بأي حساب لاعب حقيقي، حتى ما يبين بـ"حجوزاتي" أي حد).
      // اسم الزبون ورقمه وملاحظته كلها بالمستند الفرعي private/contact
      function validManualBooking() {
        let d = request.resource.data;
        return d.isManual == true
          && d.userId == ''
          && isFieldOwner(d.fieldId)
          && validSlotValues()
          && !('userPhone' in d) && !('customerName' in d) && !('note' in d);
      }

      // القراءة لأي مسجّل — بس المستند هنا ما بيه غير معلومات الوقت
      // المحجوز (منشأة/تاريخ/ساعة)، بلا ولا رقم هاتف ولا اسم زبون
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && validBookingId()
        && (validPlayerBooking() || validManualBooking());
      // بعد الإنشاء: يتحدث فقط ما عدا الحقول اللي تحدد الحجز وقيمته
      // المالية — هذي ثابتة للأبد حتى ما تنفتح ثغرة "نقل" حجز أو تلاعب
      // بالعربون بعد الحجز
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['fieldId', 'date', 'hour', 'deposit', 'depositWaived']);
      allow delete: if request.auth != null
        && (resource.data.userId == request.auth.uid
            || isFieldOwner(resource.data.fieldId));
    }

    // بيانات التواصل الخاصة بالحجز: رقم اللاعب، أو اسم زبون الحجز
    // اليدوي ورقمه وملاحظته. مستند واحد لكل حجز، ما يقراه غير صاحب
    // الحجز نفسه وصاحب المنشأة — ولا أي لاعب ثاني بالتطبيق.
    //
    // القواعد ما تقرأ المستند الأب عمداً: الحجز وبيانات تواصله ينكتبون
    // بدفعة وحدة (batch)، والدفعة تتقيّم على الحالة اللي قبل الكتابة
    // فالأب بعده ما موجود. بدالها البيانات تحمل هوية الحجز وياها
    // ونطابقها بمعرّف المستند نفسه.
    match /bookings/{bookingId}/private/contact {
      function ownsField(fieldId) {
        return exists(/databases/$(database)/documents/fields/$(fieldId))
          && get(/databases/$(database)/documents/fields/$(fieldId))
               .data.ownerId == request.auth.uid;
      }

      function validContact() {
        let d = request.resource.data;
        return d.keys().hasOnly(['userId', 'fieldId', 'date', 'hour',
                                 'userPhone', 'customerName', 'note'])
          && d.userId is string
          && d.fieldId is string && d.date is string && d.hour is int
          && bookingId == d.fieldId + '_' + d.date + '_' + string(d.hour)
          && d.userPhone is string && d.userPhone.size() <= 20
          && d.customerName is string && d.customerName.size() <= 50
          && d.note is string && d.note.size() <= 120;
      }

      // اللاعب يكتب رقمه هو الموثّق بحسابه — مو أي رقم يريده
      function playerContact() {
        let d = request.resource.data;
        return d.userId == request.auth.uid
          && d.userPhone == request.auth.token.phone_number
          && d.customerName == '' && d.note == '';
      }

      // صاحب المنشأة يكتب بيانات زبون حجزه اليدوي
      function ownerContact() {
        let d = request.resource.data;
        return d.userId == ''
          && ownsField(d.fieldId)
          && d.customerName.size() > 0;
      }

      allow read: if request.auth != null
        && resource != null
        && (resource.data.userId == request.auth.uid
            || ownsField(resource.data.fieldId));
      // الحذف يمشي وياه حذف الحجز نفسه بدفعة وحدة. `resource == null`
      // مسموحة عمداً: حجوزات قديمة انكتبت قبل ما ينوجد هذا المستند
      // الفرعي، وبدونها تنكسر عملية الإلغاء كلها عليها
      allow delete: if request.auth != null
        && (resource == null
            || resource.data.userId == request.auth.uid
            || ownsField(resource.data.fieldId));
      allow create, update: if request.auth != null
        && validContact()
        && (playerContact() || ownerContact());
    }

    // سجل الإلغاءات الصادرة من أصحاب الملاعب — دليل دائم:
    // - القراءة لأي مسجّل (منها تنحسب نسبة الالتزام المعروضة للاعبين)
    // - الكتابة فقط من صاحب الملعب نفسه وعلى ملعبه هو
    // - اللاعب المتضرر يعدّل حقلين بس: شافه (seen) واستخدم ضمانه
    //   (compensated) — ما يگدر يغيّر الوقائع
    // - ما ينحذف أبداً: لا صاحب الملعب يمحي تاريخه ولا اللاعب
    match /cancellations/{cancellationId} {
      function ownsField(fieldId) {
        return exists(/databases/$(database)/documents/fields/$(fieldId))
          && get(/databases/$(database)/documents/fields/$(fieldId))
               .data.ownerId == request.auth.uid;
      }

      // معرّف السجل نفس معرّف الحجز الملغى — نتأكد إن هذا الحجز كان
      // موجود فعلاً وتابع لنفس الملعب ونفس اللاعب المذكور بالسجل، حتى
      // ما يگدر مالك يفبرك سجل إلغاء بحق لاعب ما حجز عنده أصلاً
      // (الحجز يبقى موجود وقت الكتابة — السجل يُكتب قبل حذف الحجز)
      function realBooking(fieldId, playerId) {
        return exists(/databases/$(database)/documents/bookings/$(cancellationId))
          && get(/databases/$(database)/documents/bookings/$(cancellationId))
               .data.fieldId == fieldId
          && get(/databases/$(database)/documents/bookings/$(cancellationId))
               .data.userId == playerId;
      }

      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && ownsField(request.resource.data.fieldId)
        && request.resource.data.playerId is string
        && request.resource.data.playerId != request.auth.uid
        && realBooking(request.resource.data.fieldId, request.resource.data.playerId)
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 120
        && request.resource.data.seen == false
        && request.resource.data.compensated == false;
      allow update: if request.auth != null
        && resource.data.playerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['seen', 'compensated'])
        && request.resource.data.seen is bool
        && request.resource.data.compensated is bool;
      allow delete: if false;
    }

    // ملف المستخدم (الاسم والمفضلة ونوع الحساب): صاحبه فقط يقرأ ويكتب.
    // createdAt يتثبت أول مرة وما يتغيّر بعدها (نفس نمط مجموعة players)
    // حتى ما يگدر المستخدم يزوّر مدة عضويته المعروضة له.
    match /users/{userId} {
      // نوع الحساب: لاعب أو صاحب منشأة فقط — إذا انكتب أصلاً
      function validAccountType() {
        let keys = request.resource.data.diff(resource.data).affectedKeys();
        return !keys.hasAny(['accountType'])
          || request.resource.data.accountType in ['player', 'owner'];
      }

      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && (!request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['createdAt'])
            || !('createdAt' in resource.data))
        && validAccountType();
      allow delete: if false;
    }

    // التقييمات: أي مسجّل يقراها، وصاحب التقييم فقط ينشر/يعدّل/يحذف
    // معرّف المستند fieldId_userId يضمن تقييم واحد لكل مستخدم بالملعب
    match /reviews/{reviewId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && reviewId == request.resource.data.fieldId + '_' + request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 200
        // الاسمين ينعرضون بقائمة التقييمات — نوع وحد أقصى، حتى ما
        // ينحقن نص ضخم أو قيمة مو نصية تخرّب الشاشة
        && request.resource.data.userName is string
        && request.resource.data.userName.size() > 0
        && request.resource.data.userName.size() <= 50
        && request.resource.data.fieldName is string
        && request.resource.data.fieldName.size() <= 50;
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // إعلانات "ناقصنا لاعب": أي مسجّل يقراها، وصاحب الإعلان فقط يعدّل أو يحذف
    match /playerRequests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.phone == request.auth.token.phone_number
        && request.resource.data.place is string
        && request.resource.data.place.size() <= 50
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 100;
      // بعد النشر: الرقم وصاحب الإعلان ثابتين للأبد — بدونها يگدر
      // اللاعب ينشر إعلان برقمه الموثّق وبعدين يبدّله لأي رقم يريده
      // (تزوير هوية بإعلان مقروء من كل التطبيق)
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.phone == resource.data.phone;
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // انضمامات "ناقصنا لاعب": دليل حقيقي كل مرة لاعب يتطوع يكمّل نقص
    // فريق — منه تنحسب شارة "منقذ". معرّف المستند requestId_uid يمنع
    // الاحتساب المكرر لنفس الإعلان. ما تنفع على إعلانك انت، وما تنعدّل
    // بعد ما تنكتب (يا تبقى يا تنحذف بانسحاب اللاعب).
    match /requestResponses/{responseId} {
      // الإعلان موجود فعلاً وصاحبه هو المرسل بالبيانات (منع انتحال هوية)
      function validRequestOwner(reqId, requesterId) {
        return exists(/databases/$(database)/documents/playerRequests/$(reqId))
          && get(/databases/$(database)/documents/playerRequests/$(reqId))
               .data.userId == requesterId;
      }

      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.joinerId == request.auth.uid
        && request.resource.data.requesterId != request.auth.uid
        && responseId == request.resource.data.requestId + '_' + request.auth.uid
        && validRequestOwner(
             request.resource.data.requestId,
             request.resource.data.requesterId
           );
      allow update: if false;
      allow delete: if request.auth != null
        && resource.data.joinerId == request.auth.uid;
    }

    // سجل إلغاء اللاعب حجزه بنفسه — دليل دائم لشارة "ملتزم"
    // (ما ألغى ولا حجز). معرّف المستند نفس معرّف الحجز الملغي، وما ينعدّل
    // أو ينحذف بعد ما ينكتب — نفس مبدأ سجل إلغاءات أصحاب الملاعب.
    match /playerCancellations/{cancelId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // الملف العام للاعب: اسم/مدينة/صورة/تاريخ الانضمام — نسخة آمنة
    // للعرض العام (بدون رقم هاتف ولا مفضلة، تبقى بمستند users الخاص).
    // منها تُقرأ ملفات اللاعبين الثانين وترتيب الحي. صاحبها فقط يكتبها،
    // وتاريخ الانضمام يتثبت أول مرة وما يتغيّر بعدها.
    match /players/{playerId} {
      function validPlayerFields() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'city', 'photoUrl', 'createdAt'])
          && (!('name' in d)
                || (d.name is string && d.name.size() <= 50))
          && (!('city' in d)
                || (d.city is string && d.city.size() <= 30))
          && (!('photoUrl' in d)
                || (d.photoUrl is string && d.photoUrl.size() <= 500
                    && (d.photoUrl == '' || d.photoUrl.matches('https://.*'))));
      }

      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == playerId
        && validPlayerFields();
      allow update: if request.auth != null
        && request.auth.uid == playerId
        && validPlayerFields()
        && (!request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['createdAt'])
            || !('createdAt' in resource.data));
      allow delete: if false;
    }

    // اقتراحات الملاعب — لاعب يبلغ عن ملعب/منشأة ما موجودة بالتطبيق.
    // معرّف المستند مبني بالتطبيق من اسم الملعب + منطقته (تطابق تقريبي)،
    // فلو أكثر من لاعب اقترح نفس الملعب يصير "تحديث" (زيادة عدّاد) بدل
    // "إنشاء" مستند جديد — الحالتين مفصولتين هنا بوضوح.
    match /venueSuggestions/{suggestionId} {
      // اقتراح جديد بالكامل: كل الحقول، والحالة تبدي "قيد المراجعة"
      // وطالب واحد بس (صاحب الاقتراح نفسه)
      function validNewSuggestion() {
        let d = request.resource.data;
        return d.name is string && d.name.size() > 0 && d.name.size() <= 50
          && d.area is string && d.area.size() > 0 && d.area.size() <= 50
          && d.mapsUrl is string && d.mapsUrl.size() <= 500
              && (d.mapsUrl == '' || d.mapsUrl.matches('https://.*'))
          && d.phone is string
              && (d.phone == '' || d.phone.matches('\\+9647[0-9]{9}'))
          && d.note is string && d.note.size() <= 200
          && d.status == 'pending'
          && d.userId == request.auth.uid
          && d.requestCount == 1
          && d.requesterIds is list && d.requesterIds.size() == 1
          && d.requesterIds[0] == request.auth.uid;
      }

      // لاعب اقترح ملعب مقترح گبل من لاعب ثاني: يزيد العدّاد بالضبط
      // واحد ويضيف نفسه لقائمة الطالبين — ما يگدر يحسب نفسه مرتين ولا
      // يلمس أي حقل ثاني (الاسم، المنطقة، الحالة...)
      function playerDuplicateIncrement() {
        let before = resource.data;
        let after = request.resource.data;
        return request.auth != null
          && after.diff(before).affectedKeys()
               .hasOnly(['requestCount', 'requesterIds', 'updatedAt'])
          && after.requestCount == before.requestCount + 1
          && !(request.auth.uid in before.requesterIds)
          && after.requesterIds == before.requesterIds.concat([request.auth.uid]);
      }

      // المسؤول يغيّر الحالة بس — ما يلمس أي حقل ثاني (منها العدّاد)
      function adminStatusUpdate() {
        return isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['pending', 'added', 'rejected'];
      }

      // القراءة: المسؤول يشوف الكل، واللاعب يشوف بس الاقتراحات اللي هو
      // طالبها (سواء أنشأها أو زاد صوته إلها)
      allow read: if isAdmin()
        || (request.auth != null
              && request.auth.uid in resource.data.requesterIds);
      allow create: if request.auth != null && validNewSuggestion();
      allow update: if adminStatusUpdate() || playerDuplicateIncrement();
      allow delete: if false;
    }
  }
}
