rules_version = '2';

// قواعد تخزين الصور — صور الملاعب فقط
service firebase.storage {
  match /b/{bucket}/o {

    // صاحب الملعب؟ نتأكد بقراءة مستند الملعب من Firestore
    function isFieldOwner(fieldId) {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/fields/$(fieldId))
             .data.ownerId == request.auth.uid;
    }

    // صور الملاعب:
    // - القراءة للكل (الصور تنعرض بالتطبيق لأي أحد)
    // - الرفع/التعديل: صاحب الملعب فقط، وبشرط الملف صورة وحجمه أقل من 5 ميغا
    // - الحذف: صاحب الملعب فقط
    match /field_photos/{fieldId}/{photo} {
      allow read: if true;
      allow create, update: if isFieldOwner(fieldId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isFieldOwner(fieldId);
    }

    // أي مسار ثاني: مقفل تماماً (ما كو رفع لأماكن غير صور الملاعب)
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
